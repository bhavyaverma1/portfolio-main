// TypeScript config for type checking (`npm run type`). Gatsby compiles TS itself.
// @see: https://www.typescriptlang.org/tsconfig
{
  "compilerOptions": {
    "target": "ES6",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "jsx": "react",
    "strict": true,
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": true
  },
  "include": [
    "src/**/*",
    "gatsby-*.ts",
    "gatsby-*.tsx"
  ]
}
